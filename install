#!/usr/bin/env bash
set -euo pipefail
cd -P -- "$(dirname -- "$0")"

autostart=0
case "${1:-}" in
    "") ;;
    --autostart) autostart=1 ;;
    -h|--help)
        printf 'Usage: %s [--autostart]\n' "$0"
        printf 'Prepare the runtime, enable the widget and start the hidden worker.\n'
        printf 'Login startup is enabled only with --autostart.\n'
        exit 0
        ;;
    *) printf 'Unknown option. Use --help.\n' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf 'Use at most one option.\n' >&2; exit 2; }

for command in omarchy systemctl curl jq flock sha256sum cmp install git; do
    command -v "$command" >/dev/null || { printf 'Required command missing: %s\n' "$command" >&2; exit 1; }
done

state="${XDG_DATA_HOME:-$HOME/.local/share}/omasky"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ "$config" != "$HOME/.config" ]]; then
    printf 'Omarchy plugins currently require XDG_CONFIG_HOME to be unset or $HOME/.config. No installation was performed.\n' >&2
    exit 1
fi
unit="$config/systemd/user/omanova-worker.service"
id=$(jq -er '.id' manifest.json)
plugin="$config/omarchy/plugins/$id"
mkdir -p "$state"
chmod 700 "$state"
exec 9>"$state/install.lock"
flock -n 9 || { printf 'An OMANOVA installation is already in progress.\n' >&2; exit 1; }

# Refuse incompatible existing state before downloading or installing anything.
if [[ -e "$state/runtime" || -L "$state/runtime" ]]; then
    if [[ ! -L "$state/runtime" || "$(realpath -- "$state/runtime")" != "$PWD" ]]; then
        printf 'Run the installer from your existing OMANOVA runtime checkout.\n' >&2
        exit 1
    fi
fi
if [[ -e "$unit" || -L "$unit" ]]; then
    if [[ -L "$unit" ]] || ! cmp -s systemd/omanova-worker.service "$unit"; then
        printf 'Existing service differs. Back it up and review the bundled unit before installing.\n' >&2
        exit 1
    fi
fi
manager_data=$(systemctl --user show-environment | sed -n 's/^XDG_DATA_HOME=//p')
manager_data="${manager_data:-$HOME/.local/share}"
if [[ "$state" != "$manager_data/omasky" ]]; then
    printf 'The user service manager uses a different data directory. Import your XDG_DATA_HOME into it before retrying.\n' >&2
    exit 1
fi
repository=https://github.com/shaggyrs6-netizen/omanova.git
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
# Install the widget from this checkout, never from a moving remote HEAD.
# Release archives without Git metadata use their version tag and the same
# byte-for-byte check before any widget is installed or updated.
if [[ -e .git ]]; then
    git clone --quiet --no-hardlinks --no-checkout "$PWD" "$stage/widget"
    revision=$(git rev-parse HEAD)
else
    revision="v$(jq -er .version manifest.json)"
    git clone --quiet --no-checkout --branch "$revision" "$repository" "$stage/widget"
fi
git -C "$stage/widget" checkout --quiet --detach "$revision"
for file in manifest.json BarWidget.qml SkyState.qml SkyPanel.qml Compass.qml SettingsPage.qml; do
    cmp -s "$file" "$stage/widget/$file" || {
        printf 'Widget source differs from its Git revision. Commit the widget changes or use a matching release.\n' >&2
        exit 1
    }
done
if [[ -e "$plugin" ]]; then
    [[ -d "$plugin/.git" ]] && [[ -z $(git -C "$plugin" status --porcelain) ]] || {
        printf 'Existing widget is not a clean Git checkout. Preserve your changes before upgrading.\n' >&2
        exit 1
    }
    git -C "$plugin" fetch --quiet "$stage/widget" HEAD
    git -C "$plugin" merge-base --is-ancestor HEAD FETCH_HEAD || {
        printf 'Widget history diverges from this release. Review it before switching.\n' >&2
        exit 1
    }
fi
if ! command -v uv >/dev/null; then
    printf 'OMANOVA needs the Arch uv package. Install it now? [y/N] '
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]] || exit 1
    sudo pacman -S --needed uv
fi

# A running managed worker must be stopped before changing its environment.
# Foreground workers are left alone and cause a clear, early refusal.
if systemctl --user is-active --quiet omanova-worker.service; then
    systemctl --user stop omanova-worker.service
fi
flock -n "$state/watch.lock" true || {
    printf 'A foreground worker is running. Stop it before installing, then retry.\n' >&2
    exit 1
}
./setup-runtime

# Omarchy owns plugin installation. Do not silently mix widget and runtime versions.
if [[ ! -e "$plugin/manifest.json" ]]; then
    omarchy plugin add "$stage/widget" --yes
    git -C "$plugin" remote set-url origin "$repository"
else
    git -C "$plugin" merge --ff-only FETCH_HEAD
fi
for file in manifest.json BarWidget.qml SkyState.qml SkyPanel.qml Compass.qml SettingsPage.qml; do
    if ! cmp -s "$file" "$plugin/$file"; then
        printf 'Installed widget differs from this runtime. Update the matching widget or runtime before retrying.\n' >&2
        exit 1
    fi
done
omarchy plugin enable "$id"

if [[ ! -e "$unit" ]]; then
    install -Dm644 systemd/omanova-worker.service "$unit"
fi
systemctl --user daemon-reload
before=$(jq -r '.generated // ""' "$state/snapshot.json" 2>/dev/null || true)
systemctl --user restart omanova-worker.service
ready=0
for ((attempt=0; attempt<60; attempt++)); do
    if systemctl --user is-active --quiet omanova-worker.service &&
       jq -e --arg before "$before" '(.generated | type == "string") and (.generated > $before)' "$state/snapshot.json" >/dev/null 2>&1; then
        ready=1
        break
    fi
    result=$(systemctl --user show -p ExecMainStatus --value omanova-worker.service)
    [[ "$result" != 75 ]] || break
    sleep 1
done
if (( ! ready )); then
    printf 'Worker did not produce a fresh snapshot. Check: journalctl --user -u omanova-worker.service\n' >&2
    printf 'Stop any foreground worker before retrying. Login startup was not changed.\n' >&2
    exit 1
fi
if (( autostart )); then
    systemctl --user enable omanova-worker.service
fi
printf 'OMANOVA is ready. Set your observing location and opt into feeds in Settings.\n'
printf 'After an upgrade, run omarchy restart shell to reload the bar, then reopen OMANOVA.\n'
if (( autostart )); then
    printf 'The hidden worker will start at login.\n'
else
    printf 'Login startup was left at its existing setting. Use --autostart to enable it.\n'
fi
