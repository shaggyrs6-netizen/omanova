#!/usr/bin/env bash
set -euo pipefail
cd -P -- "$(dirname -- "$0")"
[[ $# == 0 ]] || { printf 'Usage: %s\n' "$0" >&2; exit 2; }
umask 077
state="$PWD/.preview/launch-follow"
for mode in sample live; do
    OPENBLAS_NUM_THREADS=1 .venv/bin/python observatory/follow/follow.py --root "$state" --mode "$mode" init
done
# Colour preference only; no observing locations or logs are copied.
mkdir -p "$state"
if [[ ! -e "$state/appearance.json" && -f "${XDG_DATA_HOME:-$HOME/.local/share}/omasky/appearance.json" ]]; then
    cp -- "${XDG_DATA_HOME:-$HOME/.local/share}/omasky/appearance.json" "$state/appearance.json"
fi
display=${WAYLAND_DISPLAY:?Run from a Wayland session}
[[ $display == /* ]] || display="${XDG_RUNTIME_DIR:?}/$display"
export XDG_RUNTIME_DIR="$(mktemp -d /tmp/omanova-follow.XXXXXX)" WAYLAND_DISPLAY="$display"
export QT_QPA_PLATFORM=wayland QT_QUICK_CONTROLS_STYLE=Basic
export OMANOVA_FOLLOW_ROOT="$state" OMANOVA_FOLLOW_RUNTIME="$PWD" OMASKY_STATE="$state"
exec qs -n --no-color -p "$PWD/observatory/follow/Window.qml"
