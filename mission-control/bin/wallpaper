#!/usr/bin/env python3
"""Local wallpaper with explicit opt-in startup; never changes the normal theme."""
import fcntl,json,os,shutil,signal,subprocess,sys,time
from pathlib import Path
os.umask(0o077)
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
import startup_options
ROOT=Path(__file__).resolve().parents[1]
RUN=Path(os.environ.get('XDG_RUNTIME_DIR','/run/user/'+str(os.getuid())))/'omanova-mission-control-trial'
RUN.mkdir(mode=0o700,exist_ok=True)
RECEIPT=RUN/'session.json'
BINARY=ROOT/'build/omanova-mission-control-preview'

def starttime(pid):
 try:return (Path('/proc')/str(pid)/'stat').read_text().rsplit(')',1)[1].split()[19]
 except (OSError,IndexError):return None

def read():
 try:return json.loads(RECEIPT.read_text())
 except (OSError,ValueError):return {}

def owned(r):
 try:return r.get('start') is not None and starttime(r['pid'])==r['start'] and os.getpgid(r['pid'])==r['pid'] and os.readlink(f"/proc/{r['pid']}/exe").removesuffix(' (deleted)')==str(BINARY)
 except (OSError,KeyError):return False

def layers():
 raw=json.loads(subprocess.check_output(['hyprctl','layers','-j'],text=True,timeout=5))
 return [row for monitor in raw.values() for values in monitor.get('levels',{}).values() for row in values if row.get('namespace')=='omanova-mission-control-trial']

def stop(r):
 if owned(r):
  os.killpg(r['pid'],signal.SIGTERM)
  for _ in range(40):
   if not owned(r) and not layers():break
   time.sleep(.1)
  if owned(r):raise RuntimeError('Trial is still closing; retry stop. No desktop configuration was changed.')
 if layers():raise RuntimeError('A trial layer remains; inspect before retrying. No unrelated process was signalled.')
 return {'status':'stopped','originalWallpaper':'retained underneath; no restore write required'}

def ready_for_wallpaper():
 display=os.environ.get('WAYLAND_DISPLAY')
 socket=RUN.parent/display if display else None
 return bool(socket and socket.is_socket() and os.access(BINARY,os.X_OK) and shutil.which('hyprctl'))

def wallpaper_status(receipt):
 try:
  startup=startup_options.status()
 except (OSError,ValueError):
  startup={'enabled':False,'available':False}
 try:
  current=layers() if shutil.which('hyprctl') else []
 except (OSError,ValueError,subprocess.SubprocessError):
  return {'running':False,'available':False,'autostart':startup['enabled'],
          'startupAvailable':False,'message':'Desktop status unavailable.'}
 running=owned(receipt) and any(row.get('pid')==receipt['pid'] for row in current)
 available=ready_for_wallpaper() and (not current or running)
 return {'running':running,'available':available,'autostart':startup['enabled'],
         'startupAvailable':available and startup['available'] and bool(shutil.which('omarchy-control')),
         'message':'A different wallpaper trial is already running.' if current and not running else
                   'Mission Control requires its renderer and an Omarchy Wayland session.' if not available else ''}

if len(sys.argv)>1 and sys.argv[1]=='startup':
 try:
  option=sys.argv[2] if len(sys.argv)>2 else 'status'
  if option not in ('status','on','off'):raise ValueError('Use startup status|on|off')
  print(json.dumps(startup_options.status() if option=='status' else startup_options.change(option=='on')))
 except Exception as e:
  print(json.dumps({'enabled':False,'available':False,'error':str(e) if isinstance(e,ValueError) else 'Startup setting unavailable; no automatic retry'}));sys.exit(1)
 sys.exit(0)
login=len(sys.argv)>1 and sys.argv[1]=='login'
if login:
 # The generator may run before the compositor has announced its layers.
 deadline=time.monotonic()+60
 while True:
  if not startup_options.status()['enabled']:sys.exit(0)
  try:
   if any(v.get('levels',{}).get('0') for v in json.loads(subprocess.check_output(['hyprctl','layers','-j'],text=True,stderr=subprocess.DEVNULL,timeout=3)).values()):break
  except (OSError,ValueError,subprocess.SubprocessError):pass
  if time.monotonic()>=deadline:raise SystemExit('Desktop not ready; normal wallpaper retained.')
  time.sleep(.5)
with (RUN/'control.lock').open('a') as lock:
 fcntl.flock(lock,fcntl.LOCK_EX)
 action='start' if login else sys.argv[1] if len(sys.argv)>1 else 'start';r=read()
 if action=='status':print(json.dumps(wallpaper_status(r)));sys.exit(0)
 if action=='stop':print(json.dumps(stop(r)));sys.exit(0)
 if action=='normal':
  try:
   stop(r)
   startup_options.change(False)
  except (ValueError,RuntimeError,OSError,subprocess.SubprocessError):
   print(json.dumps({'error':'Could not verify both desktop restore and login startup. Check the status or use Restore desktop.'}))
   sys.exit(1)
  print(json.dumps(wallpaper_status(r)));sys.exit(0)
 if action!='start' or any(x not in ('--sample','--test-restore') for x in sys.argv[2:]):raise SystemExit('Use: wallpaper start [--sample] [--test-restore] | stop | normal | status | startup status|on|off')
 if owned(r):
  if wallpaper_status(r)['running']:
   print(json.dumps({'status':'already running','pid':r['pid']}));sys.exit(0)
  stop(r)
 if layers():raise SystemExit('Existing unknown trial layer: inspect before starting another.')
 if login and not startup_options.status()['enabled']:sys.exit(0)
 if not ready_for_wallpaper():raise SystemExit('Mission Control renderer or Wayland session unavailable.')
 args=[str(BINARY),'--wallpaper']
 if '--sample' not in sys.argv:args.append('--live')
 if '--test-restore' in sys.argv:args.append('--wallpaper-self-test')
 env={**os.environ,'QT_FORCE_STDERR_LOGGING':'1'}
 with (RUN/'trial.log').open('ab') as log:
  child=subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=log,stderr=log,env=env,start_new_session=True)
 r={'pid':child.pid,'start':starttime(child.pid),'binary':str(BINARY)}
 def terminate(_signal,_frame):
  raise RuntimeError('Wallpaper start interrupted')
 previous_handler=signal.signal(signal.SIGTERM,terminate)
 try:
  RECEIPT.write_text(json.dumps(r)+'\n')
  deadline=time.monotonic()+12
  while time.monotonic()<deadline:
   if child.poll() is not None:raise RuntimeError('Wallpaper renderer exited')
   current=layers()
   controls=json.loads(subprocess.check_output(['hyprctl','clients','-j'],text=True,timeout=5))
   ready=any(c.get('pid')==child.pid and c.get('title')=='Mission Control trial — Restore desktop' and c.get('mapped') for c in controls)
   if ready and any(x.get('pid')==child.pid for x in current):
    print(json.dumps({'status':'running','pid':child.pid}),flush=True)
    break
   time.sleep(.1)
  else:raise RuntimeError('No verified wallpaper and restore window appeared')
 except (OSError,ValueError,RuntimeError,subprocess.SubprocessError):
  if child.poll() is None:
   child.terminate()
   try:child.wait(timeout=3)
   except subprocess.TimeoutExpired:child.kill();child.wait()
  print(json.dumps({'error':'Wallpaper could not start. Your normal desktop is available.'}))
  sys.exit(1)
 finally:
  signal.signal(signal.SIGTERM,previous_handler)

# Stay in the generated XDG service's lifetime; release the stop/start lock first.
if login:
 result=child.wait()
 sys.exit(0 if result in (0,-signal.SIGTERM) else result)
